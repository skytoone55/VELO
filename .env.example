# =============================================================================
# Velo — PPE Energie + Ecovolt
# =============================================================================
# Copier ce fichier vers `.env.local` (app web) ou exporter en shell pour les
# scripts dans `data/` et `scripts/`. JAMAIS committer `.env*` (sauf ce
# `.env.example`).
# =============================================================================

# --- Supabase (multi-tenant : 2 projets Supabase, charger le bon selon NEXT_PUBLIC_TENANT_ID) ---
NEXT_PUBLIC_TENANT_ID=                  # 'ppe' ou 'ecovolt'
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=              # server-side only, JAMAIS exposer client
NEXT_PUBLIC_APP_URL=

# --- Monday.com API ---
# 2 comptes distincts :
#   - PPE     (compte crm-oreka, 7 boards : ATHOME, ALEX, DIZIEN, EKL, JM, SALIH, STELLARS)
#   - Ecovolt (compte alexandredelannays-team, 1 board : Velos Cargos General #9990833105)
# Les scripts data/*.sh, data/*.py, scripts/*.js, scripts/*.mjs, scripts/*.py
# lisent MONDAY_API_KEY — exporter le token correspondant au compte ciblé avant
# de lancer le script (voir commentaire dans chaque script).
MONDAY_API_KEY=
MONDAY_BOARD_ID=                        # board ciblé (si script mono-board)
MONDAY_BOARD_IDS=                       # array JSON pour scripts multi-boards PPE

# --- Email Ecovolt (Gmail OAuth) ---
GMAIL_USER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# --- Email PPE (Microsoft 365 SMTP) ---
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- Resend (transactionnel Ecovolt) ---
RESEND_API_KEY=

# --- Webhooks ---
ECOVOLT_RETRAIT_WEBHOOK_SECRET=
